{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Total Request Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"microservices-prod\"}[1m])) by (route, status_code)",
          "legendFormat": "{{route}} ({{status_code}})"
        }
      ]
    },
    {
      "title": "P99 & P95 Request Latency (Seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{namespace=\"microservices-prod\"}[2m])) by (le))",
          "legendFormat": "p99 Latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\"microservices-prod\"}[2m])) by (le))",
          "legendFormat": "p95 Latency"
        }
      ]
    },
    {
      "title": "Active Pod Replicas vs HPA Target",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas{deployment=\"order-service\"}",
          "legendFormat": "Current Pod Replicas"
        },
        {
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{horizontalpodautoscaler=\"order-service-hpa\"}",
          "legendFormat": "HPA Desired Pods"
        }
      ]
    },
    {
      "title": "Pod CPU Utilization (% of Request)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{namespace=\"microservices-prod\"}) by (pod) / sum(kube_pod_container_resource_requests{resource=\"cpu\",namespace=\"microservices-prod\"}) by (pod) * 100",
          "legendFormat": "CPU %: {{pod}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["kubernetes", "microservices", "observability", "hpa"],
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "Kubernetes Microservices Observability Dashboard"
}
